# AI work folder (session-specific, not for version control)
.ai

# AI assistant config: only shared skills are tracked, local settings stay out
.claude/*
!.claude/skills/
.codex/*
!.codex/skills/

# Pi agent state: only the shared settings file is tracked
.pi/*
!.pi/settings.json

# Python bytecode from skill scripts
__pycache__/

# 本地文档与生成页面
/docs/

# Project specific
